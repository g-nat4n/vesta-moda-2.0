generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum ProductCondition {
  NEW_WITH_TAG
  EXCELLENT
  VERY_GOOD
  GOOD
  VINTAGE
}

enum ImageKind {
  MAIN
  FRONT
  BACK
  LABEL
  DETAIL
  FLAW
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CHECKOUT
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  passwordResetHash    String?
  passwordResetExpires DateTime?
  emailVerifyHash      String?
  emailVerifyExpires   DateTime?
  role                 Role      @default(CUSTOMER)
  cpf                  String?
  phone                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  addresses            Address[]
  orders               Order[]
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Principal")
  zip        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean @default(false)
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Look {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  story        String?
  brand        String
  size         String
  color        String
  condition    ProductCondition @default(EXCELLENT)
  measurements Json?
  priceCents   Int
  compareAtCents Int?
  stock        Int              @default(1)
  status       ProductStatus    @default(DRAFT)
  featured     Boolean          @default(false)
  uniquePiece  Boolean          @default(true)
  material     String?
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  lookId       String?
  look         Look?            @relation(fields: [lookId], references: [id])
  images       ProductImage[]
  orderItems   OrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, featured])
  @@index([categoryId])
  @@index([brand])
}

model ProductImage {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  publicId   String?
  alt        String
  kind       ImageKind @default(FRONT)
  sortOrder  Int       @default(0)
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  percentOff       Int?
  amountCents      Int?
  active           Boolean   @default(true)
  expiresAt        DateTime?
  /// Teto de usos. Código vazado não fica infinito.
  maxUses          Int       @default(100)
  usedCount        Int       @default(0)
  minSubtotalCents Int?
  orders           Order[]
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  customerName    String
  cpf             String
  phone           String
  zip             String
  street          String
  numberAddress   String
  complement      String?
  district        String
  city            String
  state           String
  status          OrderStatus @default(PENDING)
  subtotalCents   Int
  discountCents   Int         @default(0)
  shippingCents   Int         @default(0)
  totalCents      Int
  shippingMethod  String
  shippingLabel   String
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  couponCode      String?
  /// Sobe quando o link do e-mail é aberto. O token antigo deixa de valer.
  accessVersion   Int         @default(0)
  notes           String?
  items           OrderItem[]
  payment         Payment?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([email])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String
  slug        String
  brand       String
  size        String
  quantity    Int
  priceCents  Int
  imageUrl    String?
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String        @default("mercadopago")
  method                PaymentMethod @default(CHECKOUT)
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  preferenceId          String?
  providerPaymentId     String?
  pixDiscountApplied    Boolean       @default(false)
  rawPayload            Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  whatsapp  String?
  message   String
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String  @id @default(cuid())
  author    String
  role      String?
  quote     String
  featured  Boolean @default(true)
  sortOrder Int     @default(0)
}
