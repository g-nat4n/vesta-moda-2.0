# PostgreSQL
DATABASE_URL="postgresql://vesta:vesta@localhost:55432/vesta?schema=public"

# Auth.js
AUTH_SECRET="gere-uma-chave-longa-e-aleatoria"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-uma-chave-longa-e-aleatoria"
NEXTAUTH_URL="http://localhost:3000"

# Conta administrativa inicial (usada no seed)
ADMIN_EMAIL="admin@vestamoda.com"
ADMIN_PASSWORD="altere-esta-senha"

# Mercado Pago (nunca expor o access token no frontend)
# Local/teste: credenciais de TESTE + MERCADOPAGO_SANDBOX=true
# Produção: credenciais de PRODUÇÃO + MERCADOPAGO_SANDBOX=false
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Mesma public key exposta no browser (Card Payment Brick / Checkout Transparente)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Obrigatório em todo ambiente que recebe webhooks (produção e preview).
# Sem este valor o endpoint rejeita notificações (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=""
# Opcional mas recomendado: secret do webhook no painel MP (valida x-signature)
MERCADOPAGO_SANDBOX="true"
# transparent (cartão na loja) | pro (Checkout Pro redirecionado)
MERCADOPAGO_CHECKOUT="pro"
MERCADOPAGO_LOCAL_MOCK="false"
# HTTPS público para retorno automático (localhost não é aceito pelo Mercado Pago)
MERCADOPAGO_RETURN_URL="https://vesta-moda.vercel.app"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frete — Correios (contrato + cartão de postagem; sem isso só a retirada fica disponível)
CORREIOS_API_USER=""
CORREIOS_API_PASSWORD=""
CORREIOS_CARTAO_POSTAGEM=""
CORREIOS_CONTRATO=""
CORREIOS_DR=""
CORREIOS_SANDBOX="false"
SHIPPING_ORIGIN_CEP="01310100"
SHIPPING_WEIGHT_GRAMS="800"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/5500000000000"

# E-mail (recuperação de senha). Sem SMTP_USER + SMTP_PASS o link não chega na caixa.
# Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
